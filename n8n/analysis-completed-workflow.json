{
  "name": "Legal AI - Analysis Completed",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "legal-ai-analysis-completed",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "legal-ai-analysis-completed"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.event }}",
              "value2": "analysis.completed"
            }
          ]
        }
      },
      "id": "validate-event",
      "name": "Validate Event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.analysis.overall_risk }}",
              "operation": "isEqual",
              "value2": "high"
            }
          ],
          "boolean": [
            {
              "value1": "={{ $json.body.analysis.overall_risk }}",
              "value2": "critical"
            }
          ]
        },
        "combinator": "or"
      },
      "id": "check-risk-level",
      "name": "High or Critical Risk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "subject": "=Legal AI Alert: {{ $json.body.analysis.overall_risk }} risk detected",
        "text": "=Analysis completed for document: {{ $json.body.document.title }}\n\nRun ID: {{ $json.body.automation.run_id }}\nStatus: {{ $json.body.automation.status }}\n\nOverall Risk: {{ $json.body.analysis.overall_risk }}\nConfidence Score: {{ $json.body.analysis.confidence_score }}\n\nSummary available: {{ $json.body.analysis.summary_available }}\nRisk analysis available: {{ $json.body.analysis.risk_analysis_available }}\n\nTimestamp: {{ $json.body.timestamp }}",
        "options": {}
      },
      "id": "notify-email",
      "name": "Send Email Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [900, 200],
      "disabled": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/YOUR_SLACK_WEBHOOK_URL",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=Legal AI Alert: {{ $json.body.analysis.overall_risk }} risk detected for document {{ $json.body.document.title }}"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-slack",
      "name": "Send Slack Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [900, 400],
      "disabled": true
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1100, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Event": {
      "main": [
        [
          {
            "node": "High or Critical Risk?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "High or Critical Risk?": {
      "main": [
        [
          {
            "node": "Send Email Notification",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Slack Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email Notification": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Slack Notification": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "tags": [
    {
      "name": "legal-ai"
    }
  ]
}
