# OpenAI API Key (required for embeddings and analysis)
OPENAI_API_KEY=sk-your-api-key-here

# Secret Key for JWT signing (required in production, min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Environment (development, testing, production)
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FILE=legal_ai.log

# AI Validation Thresholds
# Minimum similarity score for chunks to be considered relevant (0.0-1.0)
MIN_SIMILARITY_SCORE=0.3

# Minimum confidence score required to allow response (0-100)
MIN_CONFIDENCE_SCORE=60

# Minimum number of citations required for response
MIN_CITATIONS=1

# Maximum length of citation excerpts in characters
MAX_CITATION_EXCERPT_LENGTH=300
